# Айпи базы данных
DB_HOST=127.0.0.1
# Порт базы данных, к которому будет подключаться проект
DB_PORT=1234
# Имя базы данных
DB_NAME=db
# Пользователь базы данных
DB_USER=user
# Пароль пользователя базы данных
DB_PASSWORD=password

# Путь, по которому будет храниться база данных
DB_DATA_VOLUME=~/volumes/database